    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/openai": "^1.5.5",
    "@langchain/openrouter": "^0.4.5",
    "@langchain/tavily": "^1.2.0",
    "boxen": "^8.0.1",
    "chalk": "^6.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.0.3",
    "ora": "^9.4.1",
