{
  "name": "agentic_ai_node",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "agentic": "./index.ts"
  },
  "scripts": {
    "start": "bun run index.ts",
